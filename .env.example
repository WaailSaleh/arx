# Core
COMPOSE_PROJECT_NAME=palworld
TZ=UTC
PUID=1000
PGID=1000

# Palworld server
PORT=8211
QUERY_PORT=27015
PLAYERS=16
SERVER_NAME=Palworld Server
SERVER_DESCRIPTION=Managed via Docker
ALLOW_CONNECT_PLATFORM=Steam
MULTITHREADING=true
COMMUNITY=false
RCON_ENABLED=true
RCON_PORT=25575

# Secrets (fill in or provide via CI/CD)
SERVER_PASSWORD=
ADMIN_PASSWORD=

# RCON Web Admin
RWA_HTTP_PORT=4326
RWA_USERNAME=admin
RWA_PASSWORD=

# Dozzle
DOZZLE_PORT=9999

# Watchtower (default: daily at 04:00)
WATCHTOWER_SCHEDULE=0 0 4 * * *